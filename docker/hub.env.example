# Salin ke docker/hub.env (JANGAN di-commit) lalu isi.
HUB_DOMAIN=engram.example.com
# openssl rand -hex 32
ENGRAM_HUB_JWT_SECRET=
MEMORY_TOKEN=
# Nama network Docker container nginx Anda (`docker network ls`); container engram bergabung ke sini.
NGINX_NETWORK=proxy
# Google Cloud Console > Credentials > OAuth client (Web), redirect: https://HUB_DOMAIN/hub/auth/callback/google
ENGRAM_HUB_GOOGLE_CLIENT_ID=
ENGRAM_HUB_GOOGLE_SECRET=
# GitHub > Settings > Developer settings > OAuth Apps, callback: https://HUB_DOMAIN/hub/auth/callback/github
ENGRAM_HUB_GITHUB_CLIENT_ID=
ENGRAM_HUB_GITHUB_SECRET=
